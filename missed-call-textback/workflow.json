      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst c = d.config;\nconst fromOwner = d.From === c.ownerPhone;\nconst forward = c.alertOwner && !fromOwner && d.Body.trim() !== '';\nreturn [{ json: {\n  ...d,\n  forward,\n  forwardText: 'Lead ' + d.From + ' replied: ' + d.Body,\n  twiml: '<?xml version=\"1.0\" encoding=\"UTF-8\"?><Response></Response>',\n} }];"
